DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
CORS_ORIGINS=["http://localhost:3000"]

# Seeds a dummy admin/admin attorney account when running `alembic upgrade
# head` against a fresh database. Off by default so a real deployment can't
# get this account just by migrating — set to true for local dev/CI only.
SEED_DEV_ADMIN=true
# Email set on that seeded admin account. Any address works, real or a
# throwaway you control — e.g. your.name+attorney@gmail.com still lands in
# your own inbox but is clearly a distinct/fake recipient for testing. Only
# attorneys with an email set receive lead-created notifications.
SEED_DEV_ADMIN_EMAIL=admin@example.com

# Email (leave SMTP_USERNAME/SMTP_PASSWORD blank to skip sending — logged, not an error).
# Using Gmail: enable 2-Step Verification on your Google account, then create an
# App Password at https://myaccount.google.com/apppasswords and use it below
# (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
